<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kana</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']" position="after">
                <block title="Japanese Kana" name="kana_name_settings">
                    <setting
                        id="kana_format"
                        string="Kana Format"
                        help="Format readings are stored in. Changing it applies to the readings saved from then on; the ones already stored keep the format they were saved in until they are saved again. A model given a format of its own under Technical &gt; System Parameters follows that one instead."
                    >
                        <field name="kana_format" />
                    </setting>
                    <setting
                        id="kana_restrict_chars"
                        string="Restrict Characters"
                        help="Refuse a reading, when it is saved, that holds anything but the kana of its format and spaces, besides the additional characters below."
                    >
                        <field name="kana_restrict_chars" />
                        <div class="mt8" invisible="not kana_restrict_chars">
                            <label
                                for="kana_allowed_chars"
                                string="Additional Characters"
                            />
                            <div>
                                <field
                                    name="kana_allowed_chars"
                                    placeholder="[0-9A-Za-z]"
                                    class="w-100"
                                />
                            </div>
                            <div class="text-muted">
                                A regular expression matching one character, checked on the normalized reading. Leave empty to allow the kana alone.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
