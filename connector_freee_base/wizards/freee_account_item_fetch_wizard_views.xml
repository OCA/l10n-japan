<odoo>
    <record id="view_freee_account_item_fetch_wizard_form" model="ir.ui.view">
        <field name="name">freee.account.item.fetch.wizard.form</field>
        <field name="model">freee.account.item.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Map freee Account Item">
                <group>
                    <field name="account_id" readonly="1" invisible="not account_id" />
                    <field name="journal_id" readonly="1" invisible="not journal_id" />
                    <field name="backend_id" />
                </group>
                <p class="text-muted">
                    Pick the freee Backend, click
                    <em>Fetch from freee</em> to load
                    <code>/api/1/account_items</code>, then click
                    <em>Use this</em> on the row you want to bind.
                </p>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list create="false" delete="false" edit="false">
                        <field name="shortcut_num" readonly="1" />
                        <field name="external_id" readonly="1" />
                        <field name="name" readonly="1" />
                        <field name="category" readonly="1" />
                        <field name="shortcut" optional="hide" readonly="1" />
                        <field name="available" optional="hide" readonly="1" />
                        <button
                            name="action_select"
                            type="object"
                            string="Use this"
                            class="btn-primary"
                            icon="fa-check"
                        />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_fetch"
                        type="object"
                        string="Fetch from freee"
                        class="btn-primary"
                    />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
