<odoo>
    <record id="view_account_analytic_account_form_freee" model="ir.ui.view">
        <field name="name">account.analytic.account.form.freee</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    name="freee_mapping"
                    string="freee Mapping"
                    groups="connector_freee_base.group_freee_admin"
                >
                    <group>
                        <field name="freee_section_id" readonly="1" />
                        <field name="freee_section_name" readonly="1" />
                        <div colspan="2">
                            <button
                                name="action_open_freee_section_wizard"
                                type="object"
                                string="Pick from freee"
                                class="btn-secondary"
                                icon="fa-search"
                            />
                            <button
                                name="action_clear_freee_section"
                                type="object"
                                string="Clear mapping"
                                class="btn-link"
                                icon="fa-times"
                                invisible="not freee_section_id"
                                confirm="Clear the freee section mapping? Exported deal lines using it will omit section_id."
                            />
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_account_list_freee" model="ir.ui.view">
        <field name="name">account.analytic.account.list.freee</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field
                    name="freee_section_id"
                    optional="hide"
                    readonly="1"
                    groups="connector_freee_base.group_freee_admin"
                />
                <field
                    name="freee_section_name"
                    optional="hide"
                    readonly="1"
                    groups="connector_freee_base.group_freee_admin"
                />
            </xpath>
        </field>
    </record>
</odoo>
