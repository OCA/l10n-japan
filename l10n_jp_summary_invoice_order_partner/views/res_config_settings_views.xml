<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.order_partner</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_jp_summary_invoice.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='show_sale_order_number']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="show_order_partner">
                    <div class="o_setting_left_pane">
                        <field name="show_order_partner" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="show_order_partner" />
                        <div class="text-muted">
                            Show the sales order partner in the summary invoice report lines
                        </div>
                    </div>
                </div>
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="show_order_shipping_partner"
                >
                    <div class="o_setting_left_pane">
                        <field name="show_order_shipping_partner" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="show_order_shipping_partner" />
                        <div class="text-muted">
                            Show the sales order shipping address in the summary invoice report lines
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
