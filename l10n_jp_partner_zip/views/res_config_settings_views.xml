<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.l10n_jp_partner_zip</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                <setting
                    id="l10n_jp_zip_format_setting"
                    help="How the postcodes of Japanese contacts are stored"
                >
                    <field name="l10n_jp_zip_format" widget="radio" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
