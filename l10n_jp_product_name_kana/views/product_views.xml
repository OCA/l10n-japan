<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form (kana name)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <field name="name_kana" placeholder="e.g. オフィスチェア" />
            </xpath>
        </field>
    </record>
    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.list (kana name)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="name_kana" optional="hide" />
            </field>
        </field>
    </record>
    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search (kana name)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="name_kana_search" string="Name (Kana)" />
            </field>
        </field>
    </record>
</odoo>
