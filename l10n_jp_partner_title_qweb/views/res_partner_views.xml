<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">view.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='email']" position="before">
                <label for="honorific_title" class="d-md-none" />
                <div class="d-flex align-items-baseline w-md-50 gap-2">
                    <i
                        class="oi oi-filled d-none d-md-inline-flex"
                        data-icon="badge"
                        title="Title"
                    />
                    <field name="honorific_title" placeholder="Honorific Title" />
                    <field name="honorific_title_position" />
                </div>
            </xpath>
            <xpath expr="//notebook//form//label[@for='email']" position="before">
                <label for="honorific_title" class="d-md-none" />
                <div class="d-flex align-items-baseline w-md-50 gap-2">
                    <i
                        class="oi oi-filled d-none d-md-block"
                        data-icon="badge"
                        title="Title"
                    />
                    <field name="honorific_title" placeholder="Honorific Title" />
                    <field name="honorific_title_position" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
